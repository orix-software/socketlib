[[bin]]
name = "gethttp"
path_gethttp = "test/gethttp.c"

[package]
name = "socketlib"
version = "2026.4"
authors = [ "Jede",]
license = "MIT OR Apache-2.0"
edition = "2018"
cpu = "6502"
readme = ""
repository = "https://github.com/orix-software/socketlib"
documentation = "https://orix-software.github.io/socketlib/"
description = "Socket management"
homepage = "https://github.com/orix-software/socketlib"
buildfolder = "build"
packagetype = "tgz"
codetype = "lib"
oricutron_replace_autoboot_run = "True"
templatecode = ""
orix_minimal_kernel_version = "2025.2"
enable_publish = "True"
enable_build = "True"
mike_management = "True"
lib = "True"
rom_compatible = "False"
web_doc_command = "mkdocs build"
docsfolder = "mkdocs/docs/"
default_generatedoc_version = "2026.4.7"
orixsdk_version = "2023.3.0"
orix_run_pre_script = "scripts/network.sub"

[dependencies]
inetlib = "2025.1"
ch395lib = "2024.4"

[srcfolders]
